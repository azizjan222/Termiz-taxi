{
  "expo": {
    "name": "Sarix Go",
    "slug": "sarix-go-passenger",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sarixgo",
    "userInterfaceStyle": "light",
    "runtimeVersion": "2",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1B3D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.sarixgo.passenger",
      "buildNumber": "1.0.4",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sarix Go ilovasi sizning joylashuvingizni taksi buyurtmasi uchun kerak"
      }
    },
    "android": {
      "package": "uz.sarixgo.passenger",
      "versionCode": 20,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1B3D"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/order_accepted.wav",
            "./assets/sounds/driver_arrived.wav",
            "./assets/sounds/order_completed.wav",
            "./assets/sounds/order_cancelled.wav",
            "./assets/sounds/balance_bonus.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sarix Go joylashuvingizni biladi"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#0E1B3D"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Keep R$string / R$raw fields so Firebase StringResourceValueReader and expo-notifications can resolve google_app_id, gcm_defaultSenderId and sound files dynamically.\n-keepclassmembers class **.R$* {\n    public static <fields>;\n}\n-keepnames class uz.sarixgo.passenger.**\n-keep class com.google.firebase.** { *; }\n-keep class com.google.android.gms.** { *; }\n-keep class expo.modules.notifications.** { *; }\n\n# --- fbjni hybrid objects ---\n-keepclassmembers class * {\n    com.facebook.jni.HybridData *;\n    <init>(com.facebook.jni.HybridData);\n}\n-keepclasseswithmembers class * {\n    com.facebook.jni.HybridData *;\n}\n\n# --- Hermes ---\n-keepnames class com.facebook.hermes.reactexecutor.HermesExecutor\n-keepnames class com.facebook.hermes.reactexecutor.HermesExecutorFactory\n\n# --- Kotlin reflection metadata ---\n-keep class kotlin.Metadata { *; }\n\n# --- Warning suppression ---\n-dontwarn okhttp3.**\n-dontwarn javax.annotation.**\n-dontwarn com.google.firebase.**\n",
            "extraMavenRepos": [
              "https://www.jitpack.io"
            ]
          }
        }
      ],
      "./plugins/withAndroidR8Optimization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://termiz-taxi-production.up.railway.app",
      "eas": {
        "projectId": "330d036a-8b82-4e50-8e4b-90b2e4fa93fa"
      }
    }
  }
}
