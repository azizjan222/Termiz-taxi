{
  "expo": {
    "name": "Sarix Go Termiz Sariosiyo Taxi",
    "slug": "sarix-go-passenger",
    "owner": "kholov",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sarixgo",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1B3D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.sarixgo.passenger",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sarix Go ilovasi sizning joylashuvingizni taksi buyurtmasi uchun kerak"
      }
    },
    "android": {
      "package": "uz.sarixgo.passenger",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1B3D"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sarix Go joylashuvingizni biladi"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#0E1B3D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://termiz-taxi-production.up.railway.app",
      "yandexJsApiKey": "8ddd4173-e3c5-4317-a844-554619b6bf53",
      "yandexGeocoderKey": "5883875d-6f70-49b7-806a-da33cfd0a128",
      "yandexMapsApiKey": "5883875d-6f70-49b7-806a-da33cfd0a128",
      "yandexSuggestKey": "8ddd4173-e3c5-4317-a844-554619b6bf53",
      "eas": {
        "projectId": "c928665e-9700-4f48-a08d-18b9283d9304"
      }
    }
  }
}
