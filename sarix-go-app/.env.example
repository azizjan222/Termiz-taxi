EXPO_PUBLIC_API_URL=https://termiz-taxi-production.up.railway.app
EXPO_PUBLIC_WS_URL=wss://termiz-taxi-production.up.railway.app/ws

# Yandex Maps keys (get from https://developer.tech.yandex.com)
# JavaScript API key -> the interactive map (WebView)
EXPO_PUBLIC_YANDEX_JS_API_KEY=YOUR_JAVASCRIPT_API_KEY
# Geocoder API key -> address <-> coordinates lookup
EXPO_PUBLIC_YANDEX_GEOCODER_KEY=YOUR_GEOCODER_API_KEY
# Geosuggest key -> address autocomplete
EXPO_PUBLIC_YANDEX_SUGGEST_KEY=YOUR_GEOSUGGEST_KEY
