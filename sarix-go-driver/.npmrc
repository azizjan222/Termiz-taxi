# Expo SDK 56 ships TypeScript 6, but react-i18next still declares
# `peerOptional typescript@^5`. npm treats that as a hard ERESOLVE conflict.
#
# The CI workflows already pass `--legacy-peer-deps`, but nested npm invocations
# do not inherit CLI flags — `expo install --fix` shells out to a plain
# `npm install` and fails. Setting it here makes every npm invocation agree,
# whether it comes from CI, a developer, or the Expo CLI.
legacy-peer-deps=true
