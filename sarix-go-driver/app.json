{
  "expo": {
    "name": "Sarix Go Haydovchi uchun",
    "slug": "sarix-go-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sarixgodriver",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1B3D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.sarixgo.driver",
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "uz.sarixgo.driver",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1B3D"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sarix Go Driver joylashuvni kuzatadi"
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiBaseUrl": "https://your-railway-app.up.railway.app",
      "eas": { "projectId": "" }
    }
  }
}
