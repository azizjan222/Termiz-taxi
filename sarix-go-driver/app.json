{
  "expo": {
    "name": "Sarix Driver",
    "slug": "sarix-go-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sarixgodriver",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#194083"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.sarixgo.driver",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["yandexnavi", "yandexmaps"]
      }
    },
    "android": {
      "package": "uz.sarixgo.driver",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E56B5"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ilova to'lov skrinshotini yuklash uchun galereyaga kiradi.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/new_order.wav",
            "./assets/sounds/order_cancelled.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sarix Go Driver joylashuvni kuzatadi"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "extraMavenRepos": [
              "https://www.jitpack.io"
            ]
          }
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiBaseUrl": "https://termiz-taxi-production.up.railway.app",
      "eas": {
        "projectId": "721c6dea-774c-4fbb-825f-b4ab63cb7385"
      }
    }
  }
}
