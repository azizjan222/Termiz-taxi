{
  "cli": { "version": ">= 13.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://termiz-taxi-production.up.railway.app",
        "EXPO_PUBLIC_WS_URL": "wss://termiz-taxi-production.up.railway.app/ws",
        "EXPO_PUBLIC_BOT_USERNAME": "termizsariosiyotaxi_bot"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://termiz-taxi-production.up.railway.app",
        "EXPO_PUBLIC_WS_URL": "wss://termiz-taxi-production.up.railway.app/ws",
        "EXPO_PUBLIC_BOT_USERNAME": "termizsariosiyotaxi_bot"
      }
    }
  },
  "submit": { "production": { "android": { "track": "production" } } }
}
