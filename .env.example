# ==================================
# SARIX GO - Termiz Sariosiyo Taxi
# Environment Variables
# ==================================

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_ID=5660204735
DRIVERS_GROUP_ID=-1002452524294

# Support / feedback bot (SEPARATE bot from BOT_TOKEN above). Users message this bot
# with questions/suggestions; the admin receives them and replies. Get the token from
# @BotFather. Keep it SECRET.
SUPPORT_BOT_TOKEN=your_support_bot_token_here
# Who receives & answers support messages (numeric Telegram ID). Leave empty to use ADMIN_ID.
SUPPORT_ADMIN_ID=

# Database
# IMPORTANT: On Railway/containers only a mounted VOLUME survives restarts.
#  - Best: use Postgres ->  DATABASE_URL=postgresql://user:pass@host:5432/dbname
#  - Or mount a volume at /data and leave this unset (the app auto-uses /data/sarixgo.db).
# A relative path like sqlite:///./data/sarixgo.db is WIPED on every restart and will
# log app users out / break orders. Avoid it in production.
DATABASE_URL=

# Uploaded files (profile photos, car/license docs, top-up receipts).
# Like the DB, these MUST live on a persistent volume or they vanish on redeploy.
# Leave unset to auto-use the mounted volume (RAILWAY_VOLUME_MOUNT_PATH or /data)
# under an /uploads subfolder. Set explicitly to override the directory.
UPLOAD_DIR=

# API Server
API_HOST=0.0.0.0
API_PORT=8080
# Leave blank to let the app auto-generate & persist a strong secret on the data volume.
# To set your own, generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=

# JWT (for mobile app authentication)
# MUST be a strong, STABLE secret. If it changes between deploys, everyone is logged out.
# Leave blank to auto-generate & persist one (recommended). To set your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_DAYS=30

# CORS: comma-separated list of browser origins allowed to call the API, or "*" for any.
# Native mobile apps ignore CORS, so restricting this does NOT affect the apps. Once your
# web origins are known you can lock it down, e.g.:
#   CORS_ALLOWED_ORIGINS=https://azizjan222.github.io
CORS_ALLOWED_ORIGINS=*

# OTP Configuration
OTP_PROVIDER=telegram  # Options: telegram, eskiz, mock
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
# Anti-abuse: seconds a phone must wait between OTP requests, and max codes per hour.
# Protects against SMS/OTP bombing and wasted paid SMS credit.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# SMS Provider - Eskiz.uz (only if OTP_PROVIDER=eskiz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# Order Settings
WAIT_MINUTES=30
WARN_MINUTES=10
COMMISSION_PER_PERSON=10000
COMMISSION_PARCEL=5000
COMMISSION_FULL_CAR=30000
# Percent commission charged to the driver per order AFTER their free trial ends.
COMMISSION_PERCENT=10
# Deferred commission: minutes after a driver accepts before the commission is charged.
COMMISSION_WINDOW_MINUTES=15
# How many minutes before the deduction the driver gets a heads-up push (< window).
COMMISSION_WARN_MINUTES=5
PARCEL_PRICE=30000
FULL_CAR_PRICE=400000
MIN_DRIVER_BALANCE=20000

# Driver free trial: the first N drivers who sign in get FREE_TRIAL_DAYS free
# (no commission, no minimum balance required).
FREE_TRIAL_DRIVER_LIMIT=100
FREE_TRIAL_DAYS=30

# Require drivers to submit documents (via bot) before using the driver app.
REQUIRE_DRIVER_DOCUMENTS=true
# Test phones that can use the driver app WITHOUT documents (comma-separated).
TEST_DRIVER_PHONES=+998907465161

# Support contact shown in the apps (Telegram username, no @) — the support bot.
SUPPORT_TELEGRAM=SarixGo_support_bot
# Support email for questions & suggestions (shown next to the Telegram contact).
SUPPORT_EMAIL=sarixgo.support@gmail.com

# AI Assistant (OpenAI for driver chat help)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: override the OpenAI-compatible API base URL (provider/proxy).
OPENAI_BASE_URL=https://api.openai.com/v1



# Payment providers (optional - register as merchant first)
# Click Uz: https://merchant.click.uz/
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Payme: https://merchant.payme.uz/
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true

# Manual card top-up. Set your own card number/holder (do NOT commit real values to git).
# Leave blank to hide the manual card top-up method entirely.
TOPUP_CARD_NUMBER=
TOPUP_CARD_HOLDER=



# Twilio SMS (alternative to Eskiz - easy signup at twilio.com)
# OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=



# Telegram bot username for deep links (no @)
BOT_USERNAME=termizsariosiyotaxi_bot

# Admin panel credentials.
# ADMIN_PASSWORD has NO default: leave it blank and the app generates a strong random
# password once, persists it on the data volume, and PRINTS it in the startup logs
# (look for "🔐 Generated admin password: ..."). Set your own value to override.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
