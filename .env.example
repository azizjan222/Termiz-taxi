# ==================================
# SARIX GO - Termiz Sariosiyo Taxi
# Environment Variables
# ==================================

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_ID=5660204735
DRIVERS_GROUP_ID=-1002452524294

# Database
# IMPORTANT: On Railway/containers only a mounted VOLUME survives restarts.
#  - Best: use Postgres ->  DATABASE_URL=postgresql://user:pass@host:5432/dbname
#  - Or mount a volume at /data and leave this unset (the app auto-uses /data/sarixgo.db).
# A relative path like sqlite:///./data/sarixgo.db is WIPED on every restart and will
# log app users out / break orders. Avoid it in production.
DATABASE_URL=

# API Server
API_HOST=0.0.0.0
API_PORT=8080
API_SECRET_KEY=change_this_to_random_string_in_production

# JWT (for mobile app authentication)
# MUST be a strong, STABLE secret. If it changes between deploys, everyone is logged out.
JWT_SECRET=change_this_to_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRES_DAYS=30

# OTP Configuration
OTP_PROVIDER=telegram  # Options: telegram, eskiz, mock
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5

# SMS Provider - Eskiz.uz (only if OTP_PROVIDER=eskiz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# Order Settings
WAIT_MINUTES=30
WARN_MINUTES=10
COMMISSION_PER_PERSON=10000
COMMISSION_PARCEL=5000
COMMISSION_FULL_CAR=30000
# Percent commission charged to the driver per order AFTER their free trial ends.
COMMISSION_PERCENT=10
PARCEL_PRICE=30000
FULL_CAR_PRICE=400000
MIN_DRIVER_BALANCE=20000

# Driver free trial: the first N drivers who sign in get FREE_TRIAL_DAYS free
# (no commission, no minimum balance required).
FREE_TRIAL_DRIVER_LIMIT=100
FREE_TRIAL_DAYS=30

# Require drivers to submit documents (via bot) before using the driver app.
REQUIRE_DRIVER_DOCUMENTS=true
# Test phones that can use the driver app WITHOUT documents (comma-separated).
TEST_DRIVER_PHONES=+998907465161

# Support contact (Telegram username, no @)
SUPPORT_TELEGRAM=tg_adminstator

# AI Assistant (OpenAI for driver chat help)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: override the OpenAI-compatible API base URL (provider/proxy).
OPENAI_BASE_URL=https://api.openai.com/v1



# Payment providers (optional - register as merchant first)
# Click Uz: https://merchant.click.uz/
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Payme: https://merchant.payme.uz/
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true

# Manual card top-up
TOPUP_CARD_NUMBER=9860130147785443
TOPUP_CARD_HOLDER=YOUR_NAME



# Twilio SMS (alternative to Eskiz - easy signup at twilio.com)
# OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
